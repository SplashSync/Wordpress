msgid "Splash Sync Wordpress plugin."
msgstr "Plugin de WordPress Splash Sync."

msgid "Settings"
msgstr "Ajustes"

msgid "Save Settings"
msgstr "Guardar ajustes"

msgid "Informations"
msgstr "Información"

msgid "Connection"
msgstr "Conexión"

msgid "Products"
msgstr "Productos"

msgid "Orders"
msgstr "Pedidos"

msgid "Contents"
msgstr "Contenidos"

msgid "These parameters are provided when you create a new Server on our website."
msgstr "Estos parámetros se proporcionan al crear un nuevo servidor en nuestro sitio web."

msgid "Identifier"
msgstr "Identificador"

msgid "Unique Identifier for this website on Splash Servers."
msgstr "Identificador único de este sitio en los servidores Splash."

msgid "Encryption Key"
msgstr "Clave de cifrado"

msgid "Unique Encryption Key"
msgstr "Clave de cifrado única"

msgid "User"
msgstr "Usuario"

msgid "User to use for Webservice transactions"
msgstr "Usuario utilizado para las transacciones del servicio web"

msgid "Configuration of Products synchronization."
msgstr "Configuración de la sincronización de productos."

msgid "Custom Fields"
msgstr "Campos personalizados"

msgid "Enable Custom Fields for Products. Limited to the first %d custom fields."
msgstr "Activar los campos personalizados para los productos. Limitado a los primeros %d campos personalizados."

msgid "Orders & Invoices"
msgstr "Pedidos y facturas"

msgid "Configuration of Orders & Invoices synchronization."
msgstr "Configuración de la sincronización de pedidos y facturas."

msgid "Options in Item Names"
msgstr "Opciones en los nombres de línea"

msgid "Append order item meta data (options) to item names, in parentheses."
msgstr "Añadir los metadatos (opciones) de las líneas de pedido a los nombres de línea, entre paréntesis."

msgid "Orders Custom Fields"
msgstr "Campos personalizados de pedidos"

msgid "Enable Custom Fields for Orders. Limited to the first %d custom fields."
msgstr "Activar los campos personalizados para los pedidos. Limitado a los primeros %d campos personalizados."

msgid "Invoices Custom Fields"
msgstr "Campos personalizados de facturas"

msgid "Enable Custom Fields for Invoices. Limited to the first %d custom fields."
msgstr "Activar los campos personalizados para las facturas. Limitado a los primeros %d campos personalizados."

msgid "Configuration of Users, Posts & Pages synchronization."
msgstr "Configuración de la sincronización de usuarios, entradas y páginas."

msgid "Posts Custom Fields"
msgstr "Campos personalizados de entradas"

msgid "Enable Custom Fields for Posts. Limited to the first %d custom fields."
msgstr "Activar los campos personalizados para las entradas. Limitado a los primeros %d campos personalizados."

msgid "Pages Custom Fields"
msgstr "Campos personalizados de páginas"

msgid "Enable Custom Fields for Pages. Limited to the first %d custom fields."
msgstr "Activar los campos personalizados para las páginas. Limitado a los primeros %d campos personalizados."

msgid "Advanced"
msgstr "Avanzado"

msgid "These are some advanced parameters. Only use them uppon our request. Warning: your server may not work anymore!"
msgstr "Parámetros avanzados. Úselos solo a petición nuestra. Atención: ¡su servidor podría dejar de funcionar!"

msgid "Enable"
msgstr "Activar"

msgid "Enable advanced mode. "
msgstr "Activar el modo avanzado. "

msgid "Server Url"
msgstr "URL del servidor"

msgid "Only modify uppon our request! Default value : www.splashsync.com/ws/soap."
msgstr "¡Modificar solo a petición nuestra! Valor por defecto: www.splashsync.com/ws/soap."

msgid "Protocol"
msgstr "Protocolo"

msgid "Protocol to use for Webservice communication. Generic PHP SOAP is highly recommended."
msgstr "Protocolo utilizado para la comunicación del servicio web. Generic PHP SOAP es muy recomendable."

msgid "Self-Tests Passed !"
msgstr "¡Autocomprobaciones superadas!"

msgid "Self-Tests Failled... Please Check, your configuration."
msgstr "Fallo en las autocomprobaciones... Compruebe su configuración."

msgid "Available Objects"
msgstr "Objetos disponibles"

msgid "Available Widgets"
msgstr "Widgets disponibles"

msgid "Splash Server Ping Test"
msgstr "Prueba de ping del servidor Splash"

msgid "Splash Server Connect Test"
msgstr "Prueba de conexión del servidor Splash"

msgid "Logs"
msgstr "Registros"

msgid "Synchronize your WooCommerce data with all your applications."
msgstr "Sincronice sus datos de WooCommerce con todas sus aplicaciones."
msgid "Users"
msgstr "Usuarios"

msgid "Configuration of Customers synchronization."
msgstr "Configuración de la sincronización de clientes."

msgid "Disable Shipping Addresses Synchronization"
msgstr "Desactivar la sincronización de las direcciones de envío"

msgid "Disable Billing Addresses Synchronization"
msgstr "Desactivar la sincronización de las direcciones de facturación"

msgid "Customers shipping addresses become invisible for Splash: no listing, no reading, no commits."
msgstr "Las direcciones de envío de los clientes se vuelven invisibles para Splash: sin listado, sin lectura, sin commits."

msgid "Customers billing addresses become invisible for Splash: no listing, no reading, no commits."
msgstr "Las direcciones de facturación de los clientes se vuelven invisibles para Splash: sin listado, sin lectura, sin commits."

msgid "Invoicing address"
msgstr "Dirección de facturación"

msgid "Enable Delivery Addresses Synchronization"
msgstr "Activar la sincronización de las direcciones de entrega"

msgid "Enable Billing Addresses Synchronization"
msgstr "Activar la sincronización de las direcciones de facturación"

msgid "Expose delivery addresses entered on each order as read-only Address objects. These are the orders own addresses, not the customers account addresses."
msgstr "Expone las direcciones de entrega introducidas en cada pedido como objetos Dirección de solo lectura. Son las direcciones propias de los pedidos, no las configuradas en las cuentas de los clientes."

msgid "Expose billing addresses entered on each order as read-only Address objects. These are the orders own addresses, not the customers account addresses."
msgstr "Expone las direcciones de facturación introducidas en cada pedido como objetos Dirección de solo lectura. Son las direcciones propias de los pedidos, no las configuradas en las cuentas de los clientes."
